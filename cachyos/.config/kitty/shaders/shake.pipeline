# Shake the window that rang the bell. Bash rings it on a failed command
# (see ~/.bashrc). Swap `shaders shake` for `shaders shake_octaves` and
# `animation_step 1` for `animation_step 8` to try the x/y noise variant.
startgroup
    animation_start bell-in-window
    animation_stop 150
    animation_curve ease-out
    animation_step 1
    shaders shake

    var float max_displacement 15.0
endgroup
